DATABASE_URL="postgresql://user:password@localhost:5432/nixon_enrollment?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Comma-separated emails allowed to bootstrap as SUPER_ADMIN on first sign-in
# if the users table is empty. Use this only for initial setup.
BOOTSTRAP_SUPER_ADMIN_EMAILS="admin@nixoncollege.edu"
